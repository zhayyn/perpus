APP_NAME="Perpustakaan Digital"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8080

APP_LOCALE=id
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=perpustakaan
DB_USERNAME=perpustakaan_user
DB_PASSWORD=perpustakaan_secret

CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@perpustakaan.local"
MAIL_FROM_NAME="Perpustakaan Digital"

FILAMENT_FILESYSTEM_DISK=local

# Konfigurasi Peminjaman
LOAN_DURATION_DAYS=7
FINE_PER_DAY=1000
MAX_LOAN_BOOKS=3
